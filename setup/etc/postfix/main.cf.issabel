# Issabel 6 — Postfix de sólo salida (satélite).
#
# Este host no aloja buzones ni acepta correo entrante. Todo el correo
# generado localmente (voicemail de Asterisk, mail(), PHPMailer, CI_Email,
# cron, fail2ban) se entrega al smarthost configurado en la pantalla
# "SMTP Relay". El helper /usr/share/issabel/privileged/remotesmtp escribe
# relayhost y los parámetros SASL/TLS cuando se guarda esa configuración.

queue_directory = /var/spool/postfix
command_directory = /usr/sbin
daemon_directory = /usr/libexec/postfix
data_directory = /var/lib/postfix
mail_owner = postfix
setgid_group = postdrop

# Identidad: Postfix toma el FQDN del sistema (gethostname()) para
# myhostname/mydomain. myorigin queda en $myhostname.
myorigin = $myhostname

# Sólo escucha en loopback: nadie entrega correo desde la red.
inet_interfaces = loopback-only
inet_protocols = ipv4

# Sin buzones locales: nada se entrega localmente, todo se reenvía.
mydestination =
local_recipient_maps =
mynetworks = 127.0.0.0/8

alias_maps = hash:/etc/aliases
alias_database = hash:/etc/aliases

smtpd_banner = $myhostname ESMTP $mail_name
compatibility_level = 3.6

# Valores por defecto del relay; el helper remotesmtp los sobreescribe al
# aplicar la configuración de "SMTP Relay".
relayhost =
smtp_sasl_auth_enable = no
smtp_sasl_password_maps =
smtp_sasl_security_options = noplaintext, noanonymous
broken_sasl_auth_clients = yes
smtp_use_tls = no
smtp_tls_note_starttls_offer = no
